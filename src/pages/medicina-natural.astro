---
import ServicePage from "../components/ServicePage.astro";
import naturalMedicineImage from "../images/imageSeven.png";

const benefits = [
  { title: "Fitoterapia", description: "Plantas y extractos según tu proceso." },
  { title: "Equilibrio digestivo", description: "Apoyo para tu bienestar cotidiano." },
  { title: "Manejo emocional", description: "Recursos de bienestar que complementan tu proceso." },
  { title: "Energía natural", description: "Rutinas que acompañan tu vitalidad." },
  { title: "Bienestar integral", description: "Cuerpo, mente y emociones en diálogo." },
  { title: "Guía personalizada", description: "Recomendaciones pensadas para ti." }
];

const steps = [
  { title: "Escuchamos tu historia", description: "Revisamos tus necesidades, hábitos y objetivos." },
  { title: "Diseñamos tu guía", description: "Integramos fitoterapia y recomendaciones de bienestar." },
  { title: "Damos seguimiento", description: "Ajustamos el acompañamiento conforme a tu proceso." }
];

const testimonials = [
  { quote: "Encontré una forma más consciente de acompañar mi bienestar.", name: "Laura G.", role: "Medicina natural" },
  { quote: "La guía se sintió cercana, clara y fácil de integrar.", name: "Andrea M.", role: "Acompañamiento integral" },
  { quote: "Volví a sentir más calma y conexión con mis hábitos.", name: "Elena R.", role: "Bienestar natural" }
];
---

<ServicePage
  title="Medicina Natural | DETOXNatural"
  description="Programas de medicina natural y fitoterapia para acompañar tu bienestar integral."
  currentPath="/medicina-natural"
  category="Fitoterapia y bienestar"
  serviceName="Medicina natural"
  heroImage="/images/hero-medicina-natural.png"
  heroPosition="72% center"
  introTitle="Naturaleza para tu equilibrio"
  introText="Un acompañamiento que integra fitoterapia, hábitos y bienestar cotidiano."
  introImage={naturalMedicineImage}
  introImageAlt="Plantas y elementos de medicina natural"
  benefitsTitle="Apoyo que nace de la naturaleza"
  benefitsLead="Una mirada integral para acompañar tu cuerpo con intención."
  {benefits}
  stepsTitle="Tu proceso, paso a paso"
  {steps}
  {testimonials}
  palette={{
    deep: "#0d281d",
    middle: "#1c4632",
    glow: "#c19a57",
    panel: "#294e39",
    panelEnd: "#112f22",
    line: "rgb(202 178 114 / 0.42)"
  }}
/>
