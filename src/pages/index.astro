---
import MainLayout from "../layouts/MainLayout.astro";
import { Image } from "astro:assets";
import acupunctureImage from "../images/service-acupuntura-home.webp";
import nutritionImage from "../images/service-nutricion-home.webp";
import naturalMedicineImage from "../images/service-medicina-natural-home.webp";
---

<MainLayout
  title="DETOXNatural | Bienestar personalizado"
  description="Acupuntura, nutrición personalizada y medicina natural. Conoce tu caso y encuentra el acompañamiento que mejor se adapta a ti."
  currentPath="/"
  headerVariant="overlay"
  headerTone="forest"
>
  <section data-hero-surface class="home-hero relative isolate flex min-h-[680px] items-start overflow-hidden bg-[#263224] text-white sm:min-h-[720px] lg:min-h-screen">
    <div
      class="absolute inset-0 -z-20 hidden bg-cover bg-[position:65%_center] lg:block"
      style="background-image: url('/images/hero-home-fundador-bordado.png')"
    ></div>
    <div
      class="absolute inset-0 -z-20 bg-cover bg-[position:58%_center] lg:hidden"
      style="background-image: url('/images/hero-home-fundador-bordado-mobile.png')"
    ></div>
    <div class="absolute inset-0 -z-10 bg-gradient-to-r from-[#172117]/90 via-[#172117]/70 via-55% to-[#172117]/5"></div>
    <div class="absolute inset-0 -z-10 bg-gradient-to-t from-[#172117]/45 via-transparent to-[#172117]/10"></div>

    <div class="home-hero-content" data-hero-copy>
      <div class="max-w-2xl">
        <p class="home-hero-kicker font-semibold uppercase tracking-[0.2em] text-[#d7c18c]">
          DETOXNatural
        </p>
        <h1 class="home-hero-title mt-5 font-semibold leading-[1.02] tracking-tight">
          ¡Quítale peso a tu vida!
        </h1>
        <p class="mt-6 max-w-xl text-base leading-relaxed text-white/85 sm:text-lg">
          Acupuntura, nutrición y medicina natural, según tu caso.
        </p>
        <div class="home-hero-actions home-hero-actions-desktop mt-8" data-hero-actions>
          <a
            href="https://wa.me/529611448411?text=Hola%2C%20me%20gustar%C3%ADa%20agendar%20una%20consulta."
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center rounded-full bg-[#804184] px-7 py-3.5 text-sm font-semibold text-white shadow-lg shadow-black/25 transition hover:bg-[#5f255f] sm:text-base"
          >
            Agenda tu consulta
          </a>
          <a
            href="#servicios"
            class="inline-flex items-center justify-center rounded-full border border-white/45 bg-white/5 px-7 py-3.5 text-sm font-semibold text-white backdrop-blur-sm transition hover:bg-white/15 sm:text-base"
          >
            Explora los servicios
          </a>
        </div>
      </div>
    </div>

    <div class="home-hero-actions home-hero-actions-mobile" data-hero-actions>
      <a
        href="https://wa.me/529611448411?text=Hola%2C%20me%20gustar%C3%ADa%20agendar%20una%20consulta."
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center justify-center rounded-full bg-[#804184] px-7 py-3.5 text-sm font-semibold text-white shadow-lg shadow-black/25 transition hover:bg-[#5f255f] sm:text-base"
      >
        Agenda tu consulta
      </a>
      <a
        href="#servicios"
        class="inline-flex items-center justify-center rounded-full border border-white/45 bg-white/5 px-7 py-3.5 text-sm font-semibold text-white backdrop-blur-sm transition hover:bg-white/15 sm:text-base"
      >
        Explora los servicios
      </a>
    </div>
  </section>

  <section id="servicios" class="bg-[#f8f5ef] py-16 sm:py-20">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
      <div class="max-w-2xl">
        <p class="text-xs font-semibold uppercase tracking-[0.2em] text-purple-700">Elige por dónde empezar</p>
        <h2 class="mt-3 text-3xl font-bold tracking-tight text-[#2b2118] sm:text-4xl">
          Tres servicios. Un plan pensado para ti.
        </h2>
        <p class="mt-4 max-w-xl text-base text-[#685c50]">
          Puedes comenzar con un servicio individual y, si lo necesitas, complementar tu proceso.
        </p>
      </div>

      <div class="mt-9 grid gap-5 md:grid-cols-3">
        <a href="/acupuntura" class="group relative isolate flex min-h-[340px] flex-col justify-end overflow-hidden rounded-[1.75rem] bg-[#25130b] p-6 text-white shadow-lg shadow-[#352116]/10 transition hover:-translate-y-1 sm:p-7">
          <Image src={acupunctureImage} alt="Aplicación de acupuntura en un espacio tranquilo" class="absolute inset-0 -z-20 h-full w-full object-cover transition duration-500 group-hover:scale-105" />
          <div class="absolute inset-0 -z-10 bg-gradient-to-t from-[#1b0b05]/95 via-[#1b0b05]/35 to-transparent"></div>
          <p class="text-xs font-semibold uppercase tracking-[0.18em] text-[#f3c68e]">Medicina Tradicional China</p>
          <h3 class="mt-2 text-3xl font-semibold">Acupuntura</h3>
          <p class="mt-2 max-w-sm text-sm leading-relaxed text-white/85">Sesiones personalizadas para acompañar tu equilibrio y bienestar.</p>
          <span class="mt-5 inline-flex items-center gap-2 text-sm font-semibold text-white">Conoce el servicio <span aria-hidden="true">↗</span></span>
        </a>

        <a href="/nutricion" class="group relative isolate flex min-h-[340px] flex-col justify-end overflow-hidden rounded-[1.75rem] bg-[#17261a] p-6 text-white shadow-lg shadow-[#352116]/10 transition hover:-translate-y-1 sm:p-7">
          <Image src={nutritionImage} alt="Comida equilibrada con ingredientes frescos y naturales" class="absolute inset-0 -z-20 h-full w-full object-cover transition duration-500 group-hover:scale-105" />
          <div class="absolute inset-0 -z-10 bg-gradient-to-t from-[#101c13]/95 via-[#101c13]/40 to-transparent"></div>
          <p class="text-xs font-semibold uppercase tracking-[0.18em] text-[#d8dca2]">Guía nutricional</p>
          <h3 class="mt-2 text-3xl font-semibold">Nutrición</h3>
          <p class="mt-2 max-w-sm text-sm leading-relaxed text-white/85">Estrategias de alimentación adaptadas a tus objetivos y rutina.</p>
          <span class="mt-5 inline-flex items-center gap-2 text-sm font-semibold text-white">Conoce el servicio <span aria-hidden="true">↗</span></span>
        </a>

        <a href="/medicina-natural" class="group relative isolate flex min-h-[340px] flex-col justify-end overflow-hidden rounded-[1.75rem] bg-[#17261a] p-6 text-white shadow-lg shadow-[#352116]/10 transition hover:-translate-y-1 sm:p-7">
          <Image src={naturalMedicineImage} alt="Preparación herbal con gotero, plantas y flores medicinales" class="absolute inset-0 -z-20 h-full w-full object-cover transition duration-500 group-hover:scale-105" />
          <div class="absolute inset-0 -z-10 bg-gradient-to-t from-[#101c13]/95 via-[#101c13]/40 to-transparent"></div>
          <p class="text-xs font-semibold uppercase tracking-[0.18em] text-[#d8dca2]">Plantas y bienestar</p>
          <h3 class="mt-2 text-3xl font-semibold">Medicina natural</h3>
          <p class="mt-2 max-w-sm text-sm leading-relaxed text-white/85">Fitoterapia y recomendaciones integradas a tu proceso.</p>
          <span class="mt-5 inline-flex items-center gap-2 text-sm font-semibold text-white">Conoce el servicio <span aria-hidden="true">↗</span></span>
        </a>
      </div>
    </div>
  </section>

  <section class="home-process relative isolate overflow-hidden py-16 text-white sm:py-20">
    <div class="home-process-glow absolute inset-0 -z-10" aria-hidden="true"></div>
    <div class="mx-auto grid max-w-6xl gap-10 px-4 sm:px-6 lg:grid-cols-[0.9fr_1.1fr] lg:items-center lg:px-8">
      <div>
        <p class="flex items-center gap-3 text-xs font-semibold uppercase tracking-[0.2em] text-[#d7b2d9]">
          <span class="h-px w-8 bg-[#b779bb]"></span>
          Tu proceso empieza escuchándote
        </p>
        <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl">Primero conocemos tu caso.</h2>
        <p class="mt-4 max-w-lg text-base leading-relaxed text-[#e3d3c4]">
          Cada persona es distinta. La consulta nos ayuda a entender tu historia y orientarte hacia el servicio adecuado.
        </p>
      </div>

      <div class="grid gap-3 sm:grid-cols-3">
        <article class="home-process-step rounded-2xl border border-white/10 bg-white/[0.04] p-5">
          <span class="home-process-index">01</span>
          <h3 class="mt-3 font-semibold">Te escuchamos</h3>
          <p class="mt-2 text-sm leading-relaxed text-[#cbbdaf]">Conocemos tu historia y objetivos.</p>
        </article>
        <article class="home-process-step rounded-2xl border border-white/10 bg-white/[0.04] p-5">
          <span class="home-process-index">02</span>
          <h3 class="mt-3 font-semibold">Te orientamos</h3>
          <p class="mt-2 text-sm leading-relaxed text-[#cbbdaf]">Exploramos opciones para tu caso.</p>
        </article>
        <article class="home-process-step rounded-2xl border border-white/10 bg-white/[0.04] p-5">
          <span class="home-process-index">03</span>
          <h3 class="mt-3 font-semibold">Armamos tu plan</h3>
          <p class="mt-2 text-sm leading-relaxed text-[#cbbdaf]">Definimos contigo los siguientes pasos.</p>
        </article>
      </div>
    </div>
  </section>

  <section class="home-closing relative isolate overflow-hidden px-4 py-16 text-center sm:px-6 sm:py-20">
    <div class="home-closing-glow absolute inset-0 -z-10" aria-hidden="true"></div>
    <div class="mx-auto max-w-3xl">
      <p class="text-xs font-semibold uppercase tracking-[0.2em] text-[#804184]">Un primer paso, a tu ritmo</p>
      <h2 class="text-3xl font-bold tracking-tight text-[#2b2118] sm:text-4xl">Empieza por una conversación</h2>
      <p class="mt-4 text-base text-[#685c50]">Cuéntanos qué buscas y te orientamos sobre cómo comenzar.</p>
      <a
        href="https://wa.me/529611448411?text=Hola%2C%20me%20gustar%C3%ADa%20agendar%20una%20consulta."
        target="_blank"
        rel="noopener noreferrer"
        class="mt-7 inline-flex min-h-12 items-center justify-center rounded-full bg-[#804184] px-7 py-3.5 text-sm font-semibold text-white shadow-md shadow-[#5f255f]/20 transition hover:-translate-y-0.5 hover:bg-[#5f255f]"
      >
        Agenda tu consulta
      </a>
    </div>
  </section>
</MainLayout>

<style>
  .home-process-glow {
    background:
      radial-gradient(ellipse at 10% 0%, rgb(128 65 132 / .16), transparent 35%),
      linear-gradient(120deg, #17251d 0%, #241d22 62%, #21140f 100%);
  }

  .home-process-step {
    position: relative;
    overflow: hidden;
    border-color: rgb(183 121 187 / .22);
    background: linear-gradient(145deg, rgb(255 255 255 / .055), rgb(255 255 255 / .025));
    box-shadow: inset 0 1px 0 rgb(255 255 255 / .06);
    transition: transform .2s ease, border-color .2s ease, background-color .2s ease;
  }

  .home-process-step::before {
    position: absolute;
    top: 0;
    left: 1.25rem;
    width: 2.5rem;
    height: 2px;
    border-radius: 0 0 999px 999px;
    background: linear-gradient(90deg, #804184, #c18bc4);
    content: "";
  }

  .home-process-step:hover {
    transform: translateY(-3px);
    border-color: rgb(183 121 187 / .48);
    background: linear-gradient(145deg, rgb(255 255 255 / .075), rgb(255 255 255 / .035));
  }

  .home-process-index {
    display: inline-grid;
    width: 2rem;
    height: 2rem;
    place-items: center;
    border: 1px solid rgb(183 121 187 / .42);
    border-radius: 999px;
    background: rgb(128 65 132 / .2);
    color: #e8c9e9;
    font-size: .7rem;
    font-weight: 700;
    letter-spacing: .08em;
  }

  .home-closing {
    border-top: 1px solid #e8ded2;
    background: #f8f5ef;
  }

  .home-closing-glow {
    background:
      radial-gradient(ellipse at 50% 0%, rgb(128 65 132 / .09), transparent 56%),
      linear-gradient(180deg, #fbf9f5, #f6f1e9);
  }

  @media (prefers-reduced-motion: reduce) {
    .home-process-step { transition: none; }
    .home-process-step:hover { transform: none; }
  }

  .home-hero-content {
    position: relative;
    z-index: 1;
    width: min(100% - 2rem, 1152px);
    margin-inline: auto;
    padding-top: 8rem;
    padding-bottom: 10rem;
  }

  .home-hero-actions {
    gap: .75rem;
  }

  .home-hero-kicker { font-size: .875rem; }
  .home-hero-title { font-size: clamp(3rem, 11vw, 3.75rem); }

  .home-hero-actions-desktop {
    display: none;
  }

  .home-hero-actions-mobile {
    position: absolute;
    z-index: 10;
    right: 1rem;
    bottom: 3rem;
    left: 1rem;
    display: grid;
  }

  @media (min-width: 640px) {
    .home-hero-content { width: min(100% - 3rem, 1152px); }
    .home-hero-actions-mobile { bottom: 4rem; grid-auto-flow: column; grid-auto-columns: max-content; justify-content: start; }
    .home-hero-kicker { font-size: 1rem; }
  }

  @media (min-width: 768px) {
    .home-hero-kicker { font-size: 1.125rem; letter-spacing: .22em; }
    .home-hero-title { font-size: clamp(4.5rem, 11vw, 6rem); }
  }

  @media (min-width: 1024px) {
    .home-hero { min-height: 100vh; min-height: 100svh; }
    .home-hero-content {
      display: flex;
      width: min(100% - 4rem, 1440px);
      min-height: 100vh;
      min-height: 100svh;
      flex-direction: column;
      justify-content: center;
      padding-top: 0;
      padding-bottom: 0;
    }
    .home-hero-kicker { font-size: 1.25rem; }
    .home-hero-title { font-size: clamp(5.5rem, 7vw, 8rem); }
    .home-hero-actions-desktop { display: flex; }
    .home-hero-actions-mobile { display: none; }
    .home-hero-actions .inline-flex { min-height: 3.75rem; padding-inline: 2.25rem; font-size: 1.1rem; }
  }
</style>
