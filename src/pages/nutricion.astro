---
import ServicePage from "../components/ServicePage.astro";
import nutritionImage from "../images/imageThree.png";

const benefits = [
  { title: "Energía estable", description: "Hábitos para sostener tu ritmo diario." },
  { title: "Bienestar digestivo", description: "Confort y alimentación más consciente." },
  { title: "Balance metabólico", description: "Un plan alineado a tus objetivos." },
  { title: "Manejo del peso", description: "Acompañamiento personalizado y sostenible." },
  { title: "Guía nutricional", description: "Recomendaciones prácticas para tu rutina." },
  { title: "Claridad mental", description: "Nutrición para apoyar tu enfoque." }
];

const steps = [
  { title: "Conocemos tu punto de partida", description: "Hablamos de tus hábitos, objetivos y estilo de vida." },
  { title: "Creamos tu plan", description: "Diseñamos una guía realista que se adapte a ti." },
  { title: "Ajustamos contigo", description: "Revisamos avances y afinamos el plan cuando lo necesites." }
];

const testimonials = [
  { quote: "Aprendí a comer con más calma y a sentirme con más energía.", name: "Sofía M.", role: "Nutrición consciente" },
  { quote: "El plan se adaptó a mi rutina y fue fácil de mantener.", name: "Mariana R.", role: "Programa nutricional" },
  { quote: "Ahora tengo herramientas claras para elegir mejor cada día.", name: "Daniela P.", role: "Acompañamiento nutricional" }
];
---

<ServicePage
  title="Nutrición | DETOXNatural"
  description="Programas de nutrición integral para transformar tu energía, metabolismo y bienestar."
  currentPath="/nutricion"
  category="Nutrición integral"
  serviceName="Nutrición"
  heroImage="/images/hero-nutricion.png"
  heroPosition="72% center"
  introTitle="Nutrición para tu bienestar"
  introText="Un plan personalizado para nutrir tu energía, digestión y hábitos."
  introImage={nutritionImage}
  introImageAlt="Alimentos frescos para nutrición integral"
  benefitsTitle="Beneficios que nutren tu día"
  benefitsLead="Una guía clara para acompañar tu bienestar desde la alimentación."
  {benefits}
  stepsTitle="Tu plan, paso a paso"
  {steps}
  {testimonials}
  palette={{
    deep: "#10241a",
    middle: "#1a3825",
    glow: "#c27a35",
    panel: "#28472e",
    panelEnd: "#122c1c",
    line: "rgb(205 167 102 / 0.42)"
  }}
/>
