---
import MainLayout from "../layouts/MainLayout.astro";
---

<MainLayout
  title="Contacto | DETOXNatural"
  description="Conéctate con DETOXNatural para agendar tu consulta o resolver tus dudas sobre nuestros servicios."
  currentPath="/contacto"
  headerVariant="overlay"
  headerTone="forest"
>
  <section
    data-hero-surface
    class="contact-hero relative isolate flex min-h-[510px] items-center overflow-hidden text-white sm:min-h-[560px]"
  >
    <div class="contact-hero-glow absolute inset-0 -z-10" aria-hidden="true"></div>
    <div class="absolute -right-28 top-1/2 -z-10 h-[26rem] w-[26rem] -translate-y-1/2 rounded-full border border-white/10 sm:right-[4%]" aria-hidden="true"></div>
    <div class="absolute -right-12 top-1/2 -z-10 h-[20rem] w-[20rem] -translate-y-1/2 rounded-full border border-[#b779bb]/20 sm:right-[8%]" aria-hidden="true"></div>

    <div class="mx-auto w-full max-w-6xl px-5 pb-16 pt-36 sm:px-8 sm:pb-20 sm:pt-40 lg:px-10">
      <div class="max-w-2xl">
        <p class="flex items-center gap-3 text-xs font-semibold uppercase tracking-[0.24em] text-[#d7b2d9] sm:text-sm">
          <span class="h-px w-8 bg-[#b779bb]"></span>
          Contacto DETOXNatural
        </p>
        <h1 class="mt-5 max-w-xl text-4xl font-semibold leading-[1.06] tracking-tight sm:text-5xl lg:text-6xl">
          Estamos aquí para escucharte.
        </h1>
        <p class="mt-5 max-w-lg text-base leading-7 text-[#f0e7df]/85 sm:text-lg">
          Cuéntanos qué necesitas. Te orientamos sobre nuestros servicios y te ayudamos a dar el siguiente paso.
        </p>
        <div class="mt-8 flex flex-col gap-3 sm:flex-row">
          <a
            href="https://wa.me/529611448411?text=Hola%2C%20me%20gustar%C3%ADa%20agendar%20una%20consulta."
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex min-h-12 items-center justify-center rounded-full bg-[#804184] px-7 py-3 text-sm font-semibold text-white shadow-lg shadow-black/25 transition hover:bg-[#6f3474] focus:outline-none focus:ring-2 focus:ring-[#d7b2d9] focus:ring-offset-2 focus:ring-offset-[#281a24]"
          >
            Escríbenos por WhatsApp
          </a>
          <a
            href="#ubicacion"
            class="inline-flex min-h-12 items-center justify-center rounded-full border border-white/30 bg-white/[0.04] px-7 py-3 text-sm font-semibold text-white transition hover:bg-white/10 focus:outline-none focus:ring-2 focus:ring-white/70"
          >
            Ver ubicación y horario
          </a>
        </div>
      </div>
    </div>
  </section>

  <section id="agenda" class="bg-[#f8f5ef] py-14 sm:py-20">
    <div class="mx-auto max-w-6xl px-5 sm:px-8 lg:px-10">
      <div class="mb-8 max-w-2xl sm:mb-10">
        <p class="text-xs font-semibold uppercase tracking-[0.2em] text-[#804184]">Tu consulta comienza aquí</p>
        <h2 class="mt-3 text-3xl font-semibold tracking-tight text-[#2b2118] sm:text-4xl">
          Hablemos de tu bienestar.
        </h2>
      </div>

      <div class="grid items-start gap-5 lg:grid-cols-[0.88fr_1.12fr] lg:gap-7">
        <aside id="ubicacion" class="contact-details rounded-[1.75rem] p-6 sm:p-8">
          <p class="text-xs font-semibold uppercase tracking-[0.18em] text-[#804184]">Estamos cerca</p>
          <h3 class="mt-2 text-2xl font-semibold tracking-tight text-[#33251e]">Visítanos o contáctanos</h3>

          <div class="mt-6 divide-y divide-[#dfd2cc]">
            <a
              href="https://www.google.com/maps/place//data=!4m2!3m1!1s0x85ecd974740d8411:0x99b928d3abe69075?utm_source=mstt_1"
              target="_blank"
              rel="noopener noreferrer"
              class="contact-detail-row group flex gap-4 py-5 first:pt-0"
            >
              <span class="contact-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" class="h-5 w-5">
                  <path d="M19 10c0 5-7 11-7 11S5 15 5 10a7 7 0 1 1 14 0Z" />
                  <circle cx="12" cy="10" r="2.3" />
                </svg>
              </span>
              <span>
                <span class="block text-sm font-semibold">Nuestra ubicación</span>
                <span class="mt-1 block text-sm leading-6 text-[#6f625a]">5a. Norte Ote. No. 384, Local B, Colonia Terán<br />Tuxtla Gutiérrez, Chiapas</span>
                <span class="mt-2 inline-block text-xs font-semibold text-[#804184] group-hover:text-[#5f255f]">Abrir mapa ↗</span>
              </span>
            </a>

            <div class="contact-detail-row flex gap-4 py-5">
              <span class="contact-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" class="h-5 w-5">
                  <circle cx="12" cy="12" r="9" />
                  <path d="M12 7v5l3.2 2" />
                </svg>
              </span>
              <span class="w-full">
                  <span class="block text-sm font-semibold text-[#3b2e28]">Horario de atención</span>
                <span class="mt-2 grid grid-cols-[1fr_auto] gap-x-4 gap-y-1.5 text-sm text-[#6f625a]">
                  <span>Lunes a viernes</span><span>9:00 a 18:00</span>
                  <span>Sábado</span><span>10:00 a 14:00</span>
                  <span>Domingo</span><span>Cerrado</span>
                </span>
              </span>
            </div>

            <div class="contact-detail-row flex gap-4 py-5 last:pb-0">
              <span class="contact-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" class="h-5 w-5">
                  <path d="M5 4h3l2 5-2 1.5a14 14 0 0 0 5.5 5.5L15 14l5 2v3a2 2 0 0 1-2 2C10 21 3 14 3 6a2 2 0 0 1 2-2Z" />
                </svg>
              </span>
              <span>
                <span class="block text-sm font-semibold text-[#3b2e28]">Contacto directo</span>
                <a href="tel:+529611448411" class="mt-1 block text-sm text-[#6f625a] transition hover:text-[#804184]">961 144 8411</a>
                <a href="mailto:detoxnatural@hotmail.com" class="mt-1 block break-all text-sm text-[#6f625a] transition hover:text-[#804184]">detoxnatural@hotmail.com</a>
              </span>
            </div>
          </div>
        </aside>

        <div id="formulario-contacto" class="contact-form-card rounded-[1.75rem] p-6 sm:p-8 lg:p-9">
          <div class="flex items-start justify-between gap-4">
            <div>
              <p class="text-xs font-semibold uppercase tracking-[0.18em] text-[#804184]">Agenda o pregunta</p>
              <h3 class="mt-2 text-2xl font-semibold tracking-tight text-[#2b2118]">Cuéntanos qué necesitas</h3>
              <p class="mt-2 max-w-lg text-sm leading-6 text-[#6b625a]">Responde estas preguntas breves y continuamos por WhatsApp.</p>
            </div>
            <span class="contact-form-mark hidden h-12 w-12 shrink-0 items-center justify-center rounded-2xl text-[#804184] sm:flex" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" class="h-6 w-6">
                <path d="M4 5.5h16v13H4z" />
                <path d="m4.5 7 7.5 6 7.5-6" />
              </svg>
            </span>
          </div>

          <form id="contact-whatsapp-form" class="mt-6 space-y-4">
            <div>
              <label for="nombre" class="mb-1.5 block text-sm font-medium text-[#3f342e]">¿Cómo te llamas?</label>
              <input
                id="nombre"
                name="nombre"
                type="text"
                autocomplete="name"
                placeholder="Tu nombre"
                required
                class="contact-input"
              />
            </div>
            <div>
              <label for="servicio-trigger" class="mb-1.5 block text-sm font-medium text-[#3f342e]">¿Qué servicio te interesa?</label>
              <div class="contact-picker" data-service-picker>
                <input id="servicio" name="servicio" type="hidden" value="" />
                <button
                  id="servicio-trigger"
                  type="button"
                  class="contact-input contact-picker-trigger"
                  aria-haspopup="listbox"
                  aria-expanded="false"
                  aria-controls="service-options"
                  aria-describedby="service-error"
                >
                  <span data-service-label>Selecciona una opción</span>
                  <svg viewBox="0 0 20 20" fill="none" aria-hidden="true" class="contact-picker-chevron">
                    <path d="m5 7.5 5 5 5-5" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                </button>
                <div id="service-options" class="contact-picker-options" role="listbox" aria-label="Servicios de DETOXNatural" hidden>
                  <button type="button" class="contact-picker-option" role="option" aria-selected="false" data-value="Acupuntura">Acupuntura</button>
                  <button type="button" class="contact-picker-option" role="option" aria-selected="false" data-value="Nutrición">Nutrición</button>
                  <button type="button" class="contact-picker-option" role="option" aria-selected="false" data-value="Medicina natural">Medicina natural</button>
                  <button type="button" class="contact-picker-option" role="option" aria-selected="false" data-value="Orientación sobre los servicios">Aún no estoy seguro</button>
                </div>
              </div>
              <p id="service-error" class="contact-picker-error" role="alert" hidden>Selecciona el servicio que te interesa para continuar.</p>
            </div>
            <div>
              <label for="consulta" class="mb-1.5 block text-sm font-medium text-[#3f342e]">¿Qué te gustaría consultar? <span class="font-normal text-[#81766e]">(opcional)</span></label>
              <textarea
                id="consulta"
                name="consulta"
                rows="3"
                maxlength="240"
                placeholder="Cuéntanos brevemente"
                class="contact-input resize-y"
              ></textarea>
            </div>
            <button
              type="submit"
              class="inline-flex min-h-12 w-full items-center justify-center gap-2 rounded-full bg-[#804184] px-6 py-3 text-sm font-semibold text-white shadow-md shadow-[#804184]/20 transition hover:bg-[#6f3474] focus:outline-none focus:ring-2 focus:ring-[#804184] focus:ring-offset-2"
            >
              <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" class="h-5 w-5">
                <path d="M19.05 4.94A9.87 9.87 0 0 0 12.04 2C6.58 2 2.14 6.44 2.14 11.9c0 1.75.46 3.46 1.33 4.96L2 22l5.3-1.39a9.86 9.86 0 0 0 4.73 1.2h.01c5.45 0 9.89-4.44 9.89-9.9a9.82 9.82 0 0 0-2.88-6.97ZM12.04 20.14a8.2 8.2 0 0 1-4.18-1.14l-.3-.18-3.15.83.84-3.07-.2-.31a8.2 8.2 0 1 1 7 3.87h-.01Zm4.5-6.15c-.25-.13-1.48-.73-1.71-.81-.23-.08-.4-.13-.57.13-.17.25-.65.81-.8.98-.15.17-.3.19-.55.06-.25-.13-1.06-.39-2.02-1.25-.75-.67-1.25-1.49-1.4-1.74-.15-.25-.02-.38.11-.51.12-.12.25-.3.38-.45.13-.15.17-.25.25-.42.08-.17.04-.32-.02-.45-.06-.13-.57-1.38-.78-1.89-.2-.49-.41-.42-.57-.43h-.48c-.17 0-.45.06-.68.32-.23.25-.9.88-.9 2.15s.92 2.49 1.05 2.66c.13.17 1.81 2.76 4.38 3.87.61.26 1.08.42 1.45.54.61.19 1.17.16 1.61.1.49-.07 1.48-.61 1.69-1.2.21-.59.21-1.09.15-1.2-.06-.11-.22-.17-.47-.3Z" />
              </svg>
              Continuar por WhatsApp
            </button>
            <p class="text-center text-xs leading-5 text-[#81766e]">Se abrirá WhatsApp con tus respuestas listas para enviar.</p>
          </form>
        </div>
      </div>
    </div>
  </section>
</MainLayout>

<style>
  .contact-hero-glow {
    background:
      radial-gradient(ellipse at 76% 46%, rgb(128 65 132 / .23), transparent 36%),
      linear-gradient(115deg, #21120e 0%, #2a1b25 58%, #21150f 100%);
  }

  .contact-details {
    border: 1px solid #e5d8e4;
    background: linear-gradient(145deg, #fffaf1, #f5edf4 100%);
    box-shadow: 0 18px 42px rgb(53 34 23 / .07);
  }

  .contact-icon {
    display: flex;
    width: 2.75rem;
    height: 2.75rem;
    flex: 0 0 auto;
    align-items: center;
    justify-content: center;
    border: 1px solid rgb(128 65 132 / .18);
    border-radius: 1rem;
    background: rgb(128 65 132 / .08);
    color: #804184;
  }

  .contact-detail-row {
    min-width: 0;
  }

  .contact-form-card {
    border: 1px solid #e9dfd4;
    background: linear-gradient(145deg, #fffdfa, #fffaf4);
    box-shadow: 0 20px 55px rgb(53 34 23 / .08);
  }

  .contact-form-mark {
    border: 1px solid #e5c9ed;
    background: #f5e9f7;
  }

  .contact-input {
    display: block;
    width: 100%;
    min-height: 3rem;
    border: 1px solid #dfd5ca;
    border-radius: .9rem;
    background: #fff;
    padding: .75rem .95rem;
    color: #2b2118;
    font: inherit;
    font-size: .9rem;
    outline: none;
    transition: border-color .18s ease, box-shadow .18s ease;
  }

  .contact-input::placeholder {
    color: #a0968d;
  }

  .contact-input:focus {
    border-color: #804184;
    box-shadow: 0 0 0 3px rgb(128 65 132 / .13);
  }

  .contact-picker {
    position: relative;
  }

  .contact-picker-trigger {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    cursor: pointer;
    text-align: left;
  }

  .contact-picker-trigger[aria-expanded="true"] {
    border-color: #804184;
    box-shadow: 0 0 0 3px rgb(128 65 132 / .13);
  }

  .contact-picker-chevron {
    width: 1rem;
    height: 1rem;
    flex: 0 0 auto;
    color: #804184;
    transition: transform .18s ease;
  }

  .contact-picker-trigger[aria-expanded="true"] .contact-picker-chevron {
    transform: rotate(180deg);
  }

  .contact-picker-options {
    position: absolute;
    z-index: 20;
    top: calc(100% + .45rem);
    left: 0;
    display: grid;
    width: 100%;
    max-height: 15rem;
    gap: .2rem;
    overflow-y: auto;
    border: 1px solid #e5d8e4;
    border-radius: 1rem;
    background: #fffdfa;
    padding: .4rem;
    box-shadow: 0 16px 36px rgb(43 33 24 / .16);
  }

  .contact-picker-options[hidden] {
    display: none;
  }

  .contact-picker-option {
    min-height: 2.7rem;
    border: 0;
    border-radius: .7rem;
    background: transparent;
    padding: .65rem .8rem;
    color: #3f342e;
    cursor: pointer;
    font: inherit;
    font-size: .9rem;
    text-align: left;
    transition: background-color .15s ease, color .15s ease;
  }

  .contact-picker-option:hover,
  .contact-picker-option:focus-visible,
  .contact-picker-option[aria-selected="true"] {
    background: #f5e9f7;
    color: #5f255f;
    outline: none;
  }

  .contact-picker-error {
    margin: .4rem .15rem 0;
    color: #8b2d3d;
    font-size: .78rem;
  }

  @media (prefers-reduced-motion: reduce) {
    .contact-input, .contact-picker-chevron, .contact-picker-option { transition: none; }
  }
</style>

<script>
  const contactForm = document.querySelector<HTMLFormElement>("#contact-whatsapp-form");
  const servicePicker = document.querySelector<HTMLElement>("[data-service-picker]");
  const serviceTrigger = document.querySelector<HTMLButtonElement>("#servicio-trigger");
  const serviceOptions = document.querySelector<HTMLDivElement>("#service-options");
  const serviceValue = document.querySelector<HTMLInputElement>("#servicio");
  const serviceLabel = document.querySelector<HTMLElement>("[data-service-label]");
  const serviceError = document.querySelector<HTMLElement>("#service-error");
  const optionButtons = Array.from(
    document.querySelectorAll<HTMLButtonElement>(".contact-picker-option")
  );

  const closeServiceOptions = (restoreFocus = false) => {
    if (!serviceTrigger || !serviceOptions) return;
    serviceOptions.hidden = true;
    serviceTrigger.setAttribute("aria-expanded", "false");
    if (restoreFocus) serviceTrigger.focus();
  };

  const openServiceOptions = (focusFirst = false) => {
    if (!serviceTrigger || !serviceOptions) return;
    serviceOptions.hidden = false;
    serviceTrigger.setAttribute("aria-expanded", "true");
    if (focusFirst) optionButtons[0]?.focus();
  };

  serviceTrigger?.addEventListener("click", () => {
    if (serviceOptions?.hidden) openServiceOptions();
    else closeServiceOptions();
  });

  serviceTrigger?.addEventListener("keydown", (event) => {
    if (event.key === "ArrowDown" || event.key === "Enter" || event.key === " ") {
      event.preventDefault();
      openServiceOptions(true);
    }
  });

  servicePicker?.addEventListener("focusout", (event) => {
    if (servicePicker && event.relatedTarget instanceof Node && servicePicker.contains(event.relatedTarget)) return;
    closeServiceOptions();
  });

  optionButtons.forEach((option, index) => {
    option.addEventListener("click", () => {
      const selectedValue = option.dataset.value ?? "";
      if (serviceValue) serviceValue.value = selectedValue;
      if (serviceLabel) serviceLabel.textContent = option.textContent?.trim() ?? "";
      optionButtons.forEach((button) => {
        button.setAttribute("aria-selected", String(button === option));
      });
      serviceTrigger?.removeAttribute("aria-invalid");
      if (serviceError) serviceError.hidden = true;
      closeServiceOptions(true);
    });

    option.addEventListener("keydown", (event) => {
      if (event.key === "Escape") {
        event.preventDefault();
        closeServiceOptions(true);
      } else if (event.key === "ArrowDown") {
        event.preventDefault();
        optionButtons[(index + 1) % optionButtons.length]?.focus();
      } else if (event.key === "ArrowUp") {
        event.preventDefault();
        optionButtons[(index - 1 + optionButtons.length) % optionButtons.length]?.focus();
      } else if (event.key === "Home") {
        event.preventDefault();
        optionButtons[0]?.focus();
      } else if (event.key === "End") {
        event.preventDefault();
        optionButtons[optionButtons.length - 1]?.focus();
      }
    });
  });

  document.addEventListener("pointerdown", (event) => {
    if (servicePicker && event.target instanceof Node && !servicePicker.contains(event.target)) {
      closeServiceOptions();
    }
  });

  contactForm?.addEventListener("submit", (event) => {
    event.preventDefault();

    const form = event.currentTarget;
    if (!(form instanceof HTMLFormElement)) return;

    const formData = new FormData(form);
    const name = String(formData.get("nombre") ?? "").trim();
    const service = String(formData.get("servicio") ?? "").trim();
    const question = String(formData.get("consulta") ?? "").trim();

    if (!service) {
      serviceTrigger?.setAttribute("aria-invalid", "true");
      if (serviceError) serviceError.hidden = false;
      serviceTrigger?.focus();
      return;
    }

    const message = [
      "Hola, me gustaría agendar una consulta.",
      `Mi nombre es ${name}.`,
      `Me interesa: ${service}.`,
      question ? `Quisiera consultar: ${question}` : ""
    ].filter(Boolean).join("\n");
    const whatsappUrl = `https://wa.me/529611448411?text=${encodeURIComponent(message)}`;
    const whatsappWindow = window.open(whatsappUrl, "_blank");

    if (whatsappWindow) whatsappWindow.opener = null;
    else window.location.assign(whatsappUrl);
  });
</script>
