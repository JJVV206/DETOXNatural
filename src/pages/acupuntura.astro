---
import MainLayout from "../layouts/MainLayout.astro";
import { Image } from "astro:assets";
import imageAcup from "../images/imageFive.png";
---

<MainLayout
  title="Acupuntura | DETOXNatural"
  description="Terapias de acupuntura y tratamientos energéticos para restaurar tu equilibrio y bienestar integral."
  currentPath="/acupuntura"
  headerVariant="overlay"
>
  <section data-hero-surface class="relative isolate flex min-h-[680px] items-start overflow-hidden bg-[#210d05] text-white sm:min-h-[720px] lg:min-h-screen">
    <div
      class="absolute inset-0 -z-20 bg-cover bg-[position:68%_center] sm:bg-[position:72%_center] lg:bg-center"
      style="background-image: url('/images/hero-acupuntura.png')"
    ></div>
    <div class="absolute inset-0 -z-10 bg-gradient-to-r from-[#140704]/95 via-[#211006]/78 via-50% to-[#211006]/10"></div>
    <div class="absolute inset-0 -z-10 bg-gradient-to-t from-[#140704]/60 via-transparent to-[#140704]/25"></div>

    <div class="mx-auto w-full max-w-6xl px-4 pt-32 sm:px-6 sm:pt-32 lg:flex lg:min-h-screen lg:max-w-[1440px] lg:items-center lg:px-8 lg:pt-0">
      <div class="max-w-xl lg:max-w-2xl" data-hero-copy>
        <p class="text-base font-semibold uppercase tracking-[0.18em] text-[#f3c68e] sm:text-lg sm:tracking-[0.24em] lg:text-xl">
          Medicina Tradicional China
        </p>
        <h1 class="mt-5 text-7xl font-semibold leading-none tracking-tight text-white sm:text-8xl lg:text-[clamp(5.5rem,7vw,8rem)]">
          Acupuntura
        </h1>
        <div class="mt-12 hidden flex-col gap-3 lg:flex lg:flex-row lg:gap-4" data-hero-actions>
          <a
            href="#incluye"
            class="inline-flex items-center justify-center rounded-full border border-white/35 bg-white/5 px-6 py-3 text-sm font-semibold text-white backdrop-blur-sm transition hover:bg-white/15 lg:px-9 lg:py-4 lg:text-lg"
          >
            Ver qué incluye
          </a>
          <a
            href="/contacto#agenda"
            class="agenda-cta inline-flex items-center justify-center rounded-full bg-[#804184] px-6 py-3 text-sm font-semibold text-white shadow-lg shadow-black/25 transition hover:bg-[#5f255f] lg:px-9 lg:py-4 lg:text-lg"
          >
            Agenda tu consulta
          </a>
        </div>
      </div>
    </div>

    <div class="absolute inset-x-0 bottom-12 z-10 sm:bottom-16 lg:hidden" data-hero-actions>
      <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:max-w-[1440px] lg:px-8">
        <div class="flex max-w-xl flex-col gap-3 sm:flex-row">
          <a
            href="#incluye"
            class="inline-flex items-center justify-center rounded-full border border-white/35 bg-white/5 px-6 py-3 text-sm font-semibold text-white backdrop-blur-sm transition hover:bg-white/15"
          >
            Ver qué incluye
          </a>
          <a
            href="/contacto#agenda"
            class="agenda-cta inline-flex items-center justify-center rounded-full bg-[#804184] px-6 py-3 text-sm font-semibold text-white shadow-lg shadow-black/25 transition hover:bg-[#5f255f]"
          >
            Agenda tu consulta
          </a>
        </div>
      </div>
    </div>
  </section>

  <div class="acupuncture-content">
  <section id="incluye" class="bg-[#fff7ee] py-16 sm:py-20">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
      <div class="grid gap-10 lg:grid-cols-2 lg:items-center" data-reveal-pair>
        <div>
          <h2 class="text-2xl font-bold tracking-tight text-[#351609] sm:text-3xl">
            Acupuntura para tu bienestar
          </h2>
          <p class="mt-4 text-base text-[#6b3518]">
            Acupuntura y auriculoterapia, con atención adaptada a tu historia y objetivos.
          </p>
        </div>

        <div>
          <Image
            src={imageAcup}
            alt="Sesión de acupuntura"
            class="h-64 rounded-3xl bg-[#efd1b4] shadow-xl shadow-[#5c2a10]/20 sm:h-80"
          />
        </div>
      </div>
    </div>
  </section>

  <section id="beneficios" class="bg-[#f1ddc9] py-16 sm:py-20">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
      <div class="benefit-infographic">
        <div class="benefit-intro" data-reveal-header>
          <p class="benefit-kicker">Acupuntura</p>
          <h2 class="text-3xl font-bold tracking-tight sm:text-4xl">
            Beneficios para tu bienestar
          </h2>
          <p class="mt-4 max-w-xl text-base sm:text-lg">
            Un enfoque integral que acompaña a tu cuerpo en distintos momentos.
          </p>
        </div>

        <div class="benefit-grid" data-reveal-cards>
          <article class="benefit-point">
            <span class="benefit-index">01</span>
            <div><h3>Dolor y tensión</h3><p>Molestias musculares, articulares y de cabeza.</p></div>
          </article>
          <article class="benefit-point">
            <span class="benefit-index">02</span>
            <div><h3>Calma mental</h3><p>Estrés, descanso y equilibrio emocional.</p></div>
          </article>
          <article class="benefit-point">
            <span class="benefit-index">03</span>
            <div><h3>Bienestar digestivo</h3><p>Confort abdominal y apoyo digestivo.</p></div>
          </article>
          <article class="benefit-point">
            <span class="benefit-index">04</span>
            <div><h3>Equilibrio hormonal</h3><p>Acompañamiento en cada etapa.</p></div>
          </article>
          <article class="benefit-point">
            <span class="benefit-index">05</span>
            <div><h3>Defensas naturales</h3><p>Apoyo al sistema inmune.</p></div>
          </article>
          <article class="benefit-point">
            <span class="benefit-index">06</span>
            <div><h3>Claridad y energía</h3><p>Calma, concentración y vitalidad.</p></div>
          </article>
        </div>
      </div>
    </div>
  </section>

  <section id="sesiones" class="bg-[#fff7ee] py-16 sm:py-20">
    <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
      <h2 class="text-center text-2xl font-bold tracking-tight text-[#351609] sm:text-3xl" data-reveal-header>
        Tu sesión, paso a paso
      </h2>
      <div class="mt-8 space-y-4" data-reveal-cards>
        <details class="group rounded-2xl border border-[#e1bc96] bg-[#f6e4d1] p-4 text-[#351609]">
          <summary class="flex cursor-pointer items-center justify-between text-sm font-semibold">
            Preparación y Expectativas
            <span
              class="ml-3 text-xs text-[#98542a] group-open:rotate-180 group-open:transform"
              aria-hidden="true"
              >▾</span
            >
          </summary>
          <p class="mt-3 text-sm text-[#6b3518]">
            Hablamos de tu historial y objetivos. Usa ropa cómoda y llega con unos minutos de anticipación.
          </p>
        </details>
        <details class="group rounded-2xl border border-[#e1bc96] bg-[#f6e4d1] p-4 text-[#351609]">
          <summary class="flex cursor-pointer items-center justify-between text-sm font-semibold">
            Durante la Sesión
            <span
              class="ml-3 text-xs text-[#98542a] group-open:rotate-180 group-open:transform"
              aria-hidden="true"
              >▾</span
            >
          </summary>
          <p class="mt-3 text-sm text-[#6b3518]">
            Aplicamos agujas finas y estériles en puntos seleccionados para tu sesión.
          </p>
        </details>
        <details class="group rounded-2xl border border-[#e1bc96] bg-[#f6e4d1] p-4 text-[#351609]">
          <summary class="flex cursor-pointer items-center justify-between text-sm font-semibold">
            Sensaciones y Post-Sesión
            <span
              class="ml-3 text-xs text-[#98542a] group-open:rotate-180 group-open:transform"
              aria-hidden="true"
              >▾</span
            >
          </summary>
          <p class="mt-3 text-sm text-[#6b3518]">
            Hidrátate, sigue las recomendaciones y observa cómo responde tu cuerpo.
          </p>
        </details>
      </div>
    </div>
  </section>

  <section id="testimonios" class="bg-[#e8cfb3] py-16 sm:py-20">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
      <h2 class="text-center text-2xl font-bold tracking-tight text-[#351609] sm:text-3xl" data-reveal-header>
        Testimonios que Inspiran
      </h2>
      <div class="mt-8 grid gap-6 md:grid-cols-3" data-reveal-cards>
        <article class="rounded-2xl border border-[#dfba93] bg-[#fffaf4] p-6 text-sm shadow-sm shadow-[#6b3215]/10">
          <p class="italic text-[#4a220e]">
            “Mis molestias de espalda disminuyeron y me siento con más bienestar.”
          </p>
          <p class="mt-4 font-semibold text-[#351609]">Ana M.</p>
          <p class="text-xs text-[#8b4c25]">Paciente satisfecha</p>
        </article>
        <article class="rounded-2xl border border-[#dfba93] bg-[#fffaf4] p-6 text-sm shadow-sm shadow-[#6b3215]/10">
          <p class="italic text-[#4a220e]">
            “Me siento más tranquilo y con mayor equilibrio en mi día a día.”
          </p>
          <p class="mt-4 font-semibold text-[#351609]">Pablo R.</p>
          <p class="text-xs text-[#8b4c25]">Paciente satisfecho</p>
        </article>
        <article class="rounded-2xl border border-[#dfba93] bg-[#fffaf4] p-6 text-sm shadow-sm shadow-[#6b3215]/10">
          <p class="italic text-[#4a220e]">
            “Las sesiones se convirtieron en un espacio de calma para mí.”
          </p>
          <p class="mt-4 font-semibold text-[#351609]">Elena G.</p>
          <p class="text-xs text-[#8b4c25]">Paciente satisfecha</p>
        </article>
      </div>
    </div>
  </section>

  <section id="cta-acupuntura" class="bg-[#2b1309] py-16 sm:py-20">
    <div class="mx-auto max-w-4xl px-4 text-center sm:px-6 lg:px-8" data-reveal-header>
      <h2 class="text-2xl font-bold tracking-tight text-white sm:text-3xl">
        ¿Listo para empezar?
      </h2>
      <p class="mt-4 text-base text-[#f4d4ad] sm:text-lg">
        Agenda tu consulta y conoce un plan pensado para ti.
      </p>
      <div class="mt-6 flex justify-center">
        <a
          href="/contacto#agenda"
          class="agenda-cta rounded-full bg-[#804184] px-8 py-3 text-sm font-semibold text-white shadow-md shadow-black/25 transition hover:bg-[#5f255f]"
        >
          Agenda tu consulta
        </a>
      </div>
    </div>
  </section>
  </div>

  <style>
    .acupuncture-content {
      background: #180b06;
    }

    #incluye {
      background:
        radial-gradient(circle at 85% 15%, rgb(192 119 46 / 0.18), transparent 32%),
        linear-gradient(135deg, #211008 0%, #32190c 100%);
    }

    #beneficios {
      background:
        radial-gradient(circle at 12% 0%, rgb(205 143 67 / 0.16), transparent 28%),
        linear-gradient(135deg, #351b0e 0%, #241108 100%);
    }

    .benefit-infographic {
      position: relative;
      overflow: hidden;
      border: 1px solid rgb(215 168 101 / 0.48);
      border-radius: 2rem;
      padding: 2rem;
      background:
        radial-gradient(circle at 92% 12%, rgb(211 142 61 / 0.24), transparent 27%),
        linear-gradient(145deg, rgb(82 43 19 / 0.94), rgb(37 17 8 / 0.98));
      box-shadow: 0 24px 60px rgb(9 3 1 / 0.3), inset 0 1px 0 rgb(255 225 180 / 0.1);
    }

    .benefit-infographic::after {
      position: absolute;
      right: -3rem;
      bottom: -5rem;
      width: 14rem;
      height: 14rem;
      border: 1px solid rgb(242 196 123 / 0.16);
      border-radius: 999px;
      content: "";
    }

    .benefit-infographic::before {
      position: absolute;
      top: 2rem;
      left: 0;
      width: 3px;
      height: 5.5rem;
      border-radius: 0 999px 999px 0;
      background: linear-gradient(#b779bb, #804184);
      box-shadow: 0 0 18px rgb(128 65 132 / 0.5);
      content: "";
    }

    .benefit-intro {
      position: relative;
      z-index: 1;
      padding-bottom: 1.75rem;
      border-bottom: 1px solid rgb(224 176 106 / 0.25);
    }

    .benefit-kicker {
      margin-bottom: 0.75rem;
      color: #cf9bd1 !important;
      font-size: 0.75rem;
      font-weight: 700;
      letter-spacing: 0.22em;
      text-transform: uppercase;
    }

    .benefit-grid {
      position: relative;
      z-index: 1;
      display: grid;
      gap: 0;
      margin-top: 1.5rem;
    }

    .benefit-point {
      display: grid;
      grid-template-columns: 2.25rem minmax(0, 1fr);
      gap: 0.9rem;
      padding: 1rem 0;
      border-bottom: 1px solid rgb(224 176 106 / 0.18);
    }

    .benefit-point:last-child {
      border-bottom: 0;
    }

    .benefit-index {
      display: grid;
      width: 2.25rem;
      height: 2.25rem;
      place-items: center;
      border: 1px solid rgb(194 123 198 / 0.7);
      border-radius: 999px;
      background: rgb(128 65 132 / 0.2);
      color: #e9c9eb;
      font-size: 0.7rem;
      font-weight: 700;
      box-shadow: inset 0 1px 0 rgb(255 225 255 / 0.12);
    }

    #beneficios .benefit-point h3 {
      margin: 0;
      color: #fff;
      font-size: 1rem;
      line-height: 1.3;
    }

    .benefit-point p {
      margin: 0.25rem 0 0;
      font-size: 0.875rem;
      line-height: 1.45;
    }

    @media (min-width: 768px) {
      .benefit-infographic {
        padding: 3rem;
        border-radius: 2.5rem;
      }

      .benefit-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
        column-gap: 2.5rem;
      }

      .benefit-point:nth-last-child(2) {
        border-bottom: 0;
      }
    }

    #sesiones {
      background: linear-gradient(135deg, #1b0d07 0%, #2a150b 100%);
    }

    #testimonios {
      background:
        radial-gradient(circle at 88% 80%, rgb(191 119 45 / 0.16), transparent 32%),
        linear-gradient(135deg, #3b1f10 0%, #251108 100%);
    }

    #cta-acupuntura {
      background:
        radial-gradient(circle at 50% 0%, rgb(173 103 38 / 0.22), transparent 44%),
        #170a05;
    }

    .acupuncture-content h2 {
      color: #fff;
    }

    .acupuncture-content h3,
    .acupuncture-content .font-semibold {
      color: #f5c983;
    }

    .acupuncture-content p {
      color: #d9bd96;
    }

    #beneficios .grid > div,
    #testimonios article {
      border-color: rgb(205 151 84 / 0.42);
      background: linear-gradient(145deg, rgb(74 38 18 / 0.94), rgb(39 18 8 / 0.96));
      box-shadow: 0 16px 38px rgb(9 3 1 / 0.3), inset 0 1px 0 rgb(255 222 170 / 0.08);
    }

    #beneficios .grid > div p,
    #testimonios article p {
      color: #d9bd96;
    }

    #sesiones details {
      border-color: rgb(202 143 73 / 0.42);
      background: linear-gradient(135deg, rgb(72 35 16 / 0.92), rgb(42 20 10 / 0.96));
      color: #f5c983;
      box-shadow: inset 0 1px 0 rgb(255 222 170 / 0.07);
    }

    #sesiones details p {
      color: #d9bd96;
    }

    #sesiones details span {
      color: #e7ae63;
    }

    #sesiones details[open] {
      border-color: #b779bb;
      box-shadow: 0 0 0 1px rgb(183 121 187 / 0.16), inset 0 1px 0 rgb(255 222 170 / 0.07);
    }

    #sesiones details[open] summary {
      color: #efcfef;
    }

    #testimonios article p:last-child {
      color: #d9a4db;
    }

    #testimonios article {
      position: relative;
      box-shadow: inset 3px 0 0 #804184, 0 16px 38px rgb(9 3 1 / 0.3), inset 0 1px 0 rgb(255 222 170 / 0.08);
    }

    #testimonios article::after {
      position: absolute;
      top: 0.35rem;
      right: 1rem;
      color: rgb(183 121 187 / 0.22);
      content: "“";
      font-family: Georgia, serif;
      font-size: 4.5rem;
      line-height: 1;
      pointer-events: none;
    }

    #sesiones details,
    #sesiones details summary,
    #sesiones details p,
    #sesiones details[open] summary,
    #testimonios article p,
    #testimonios article .font-semibold,
    #testimonios article p:last-child {
      color: #fff;
    }

    #cta-acupuntura p {
      color: #d9bd96;
    }

    .acupuncture-content .agenda-cta {
      color: #fff;
    }
  </style>

  <script>
    import { animate, stagger } from "animejs";

    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    if (!reduceMotion) {
      animate("[data-hero-copy]", {
        opacity: { from: 0 },
        y: { from: 32 },
        duration: 850,
        ease: "outExpo"
      });

      animate("[data-hero-actions]", {
        opacity: { from: 0 },
        y: { from: 20 },
        delay: 180,
        duration: 700,
        ease: "outExpo"
      });

      const revealObserver = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;

            const target = entry.target;
            const cards = target.matches("[data-reveal-cards]") ? Array.from(target.children) : [target];

            animate(cards, {
              opacity: { from: 0 },
              y: { from: 28 },
              scale: { from: 0.98 },
              delay: cards.length > 1 ? stagger(80) : 0,
              duration: 700,
              ease: "outExpo"
            });

            revealObserver.unobserve(target);
          });
        },
        { threshold: 0.16, rootMargin: "0px 0px -8%" }
      );

      document
        .querySelectorAll("[data-reveal-pair] > *, [data-reveal-header], [data-reveal-cards]")
        .forEach((element) => revealObserver.observe(element));
    }
  </script>
</MainLayout>
