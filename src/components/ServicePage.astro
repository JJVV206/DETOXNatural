---
import MainLayout from "../layouts/MainLayout.astro";
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

type Benefit = { title: string; description: string };
type Step = { title: string; description: string };
type Testimonial = { quote: string; name: string; role: string };

interface Props {
  title: string;
  description: string;
  currentPath: string;
  category: string;
  serviceName: string;
  heroImage: string;
  heroPosition?: string;
  introTitle: string;
  introText: string;
  introImage: ImageMetadata;
  introImageAlt: string;
  benefitsTitle: string;
  benefitsLead: string;
  benefits: Benefit[];
  stepsTitle: string;
  steps: Step[];
  testimonials: Testimonial[];
  palette: {
    deep: string;
    middle: string;
    glow: string;
    panel: string;
    panelEnd: string;
    line: string;
  };
}

const {
  title,
  description,
  currentPath,
  category,
  serviceName,
  heroImage,
  heroPosition = "center",
  introTitle,
  introText,
  introImage,
  introImageAlt,
  benefitsTitle,
  benefitsLead,
  benefits,
  stepsTitle,
  steps,
  testimonials,
  palette
} = Astro.props as Props;

const serviceStyle = `--service-deep:${palette.deep};--service-middle:${palette.middle};--service-glow:${palette.glow};--service-panel:${palette.panel};--service-panel-end:${palette.panelEnd};--service-line:${palette.line};--service-hero-position:${heroPosition};`;
---

<MainLayout
  title={title}
  description={description}
  currentPath={currentPath}
  headerVariant="overlay"
  headerTone="forest"
>
  <div class="service-page" style={serviceStyle}>
    <section data-hero-surface class="service-hero">
      <div class="service-hero-image" style={`background-image:url('${heroImage}')`}></div>
      <div class="service-hero-overlay"></div>

      <div class="service-hero-content" data-hero-copy>
        <p class="service-category">{category}</p>
        <h1>{serviceName}</h1>
        <div class="service-hero-actions service-hero-actions-desktop" data-hero-actions>
          <a href="#incluye" class="service-secondary-action">Ver qué incluye</a>
          <a href="/contacto#agenda" class="service-agenda-action">Agenda tu consulta</a>
        </div>
      </div>

      <div class="service-hero-actions service-hero-actions-mobile" data-hero-actions>
        <a href="#incluye" class="service-secondary-action">Ver qué incluye</a>
        <a href="/contacto#agenda" class="service-agenda-action">Agenda tu consulta</a>
      </div>
    </section>

    <div class="service-content">
      <section id="incluye" class="service-intro">
        <div class="service-shell service-intro-grid" data-reveal-pair>
          <div>
            <h2>{introTitle}</h2>
            <p>{introText}</p>
          </div>
          <Image src={introImage} alt={introImageAlt} class="service-intro-image" />
        </div>
      </section>

      <section id="beneficios" class="service-benefits">
        <div class="service-shell">
          <div class="service-infographic">
            <div class="service-infographic-intro" data-reveal-header>
              <p class="service-kicker">{serviceName}</p>
              <h2>{benefitsTitle}</h2>
              <p>{benefitsLead}</p>
            </div>
            <div class="service-benefit-grid" data-reveal-cards>
              {benefits.map((benefit, index) => (
                <article class="service-benefit-point">
                  <span>{String(index + 1).padStart(2, "0")}</span>
                  <div>
                    <h3>{benefit.title}</h3>
                    <p>{benefit.description}</p>
                  </div>
                </article>
              ))}
            </div>
          </div>
        </div>
      </section>

      <section id="proceso" class="service-steps">
        <div class="service-shell service-steps-shell">
          <h2 data-reveal-header>{stepsTitle}</h2>
          <div class="service-step-list" data-reveal-cards>
            {steps.map((step, index) => (
              <details class="service-step" open={index === 0}>
                <summary>
                  <span>{String(index + 1).padStart(2, "0")}</span>
                  {step.title}
                  <b aria-hidden="true">+</b>
                </summary>
                <p>{step.description}</p>
              </details>
            ))}
          </div>
        </div>
      </section>

      <section id="testimonios" class="service-testimonials">
        <div class="service-shell">
          <h2 data-reveal-header>Historias de bienestar</h2>
          <div class="service-testimonial-grid" data-reveal-cards>
            {testimonials.map((testimonial) => (
              <article>
                <p class="service-quote">“{testimonial.quote}”</p>
                <p class="service-testimonial-name">{testimonial.name}</p>
                <p class="service-testimonial-role">{testimonial.role}</p>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section class="service-final-cta">
        <div class="service-final-copy" data-reveal-header>
          <h2>¿Listo para empezar?</h2>
          <p>Agenda tu consulta y conoce un plan pensado para ti.</p>
          <a href="/contacto#agenda" class="service-agenda-action">Agenda tu consulta</a>
        </div>
      </section>
    </div>
  </div>

  <style>
    .service-page { background: var(--service-deep); color: #fff; }
    .service-hero { position: relative; display: flex; min-height: 680px; overflow: hidden; align-items: flex-start; isolation: isolate; background: var(--service-deep); }
    .service-hero-image { position: absolute; z-index: -2; inset: 0; background-position: var(--service-hero-position); background-size: cover; }
    .service-hero-overlay { position: absolute; z-index: -1; inset: 0; background: linear-gradient(90deg, color-mix(in srgb, var(--service-deep) 95%, transparent), color-mix(in srgb, var(--service-deep) 72%, transparent) 50%, color-mix(in srgb, var(--service-deep) 10%, transparent)), linear-gradient(0deg, color-mix(in srgb, var(--service-deep) 62%, transparent), transparent 55%, color-mix(in srgb, var(--service-deep) 30%, transparent)); }
    .service-hero-content, .service-hero-actions-mobile { width: min(100% - 2rem, 1440px); margin-inline: auto; }
    .service-hero-content { padding-top: 8rem; }
    .service-hero-content > div { max-width: 42rem; }
    .service-category, .service-kicker { margin: 0; color: #e7c37b; font-size: 1rem; font-weight: 700; letter-spacing: .18em; text-transform: uppercase; }
    .service-hero h1 { max-width: 12ch; margin: 1rem 0 0; color: #fff; font-size: clamp(4.5rem, 13vw, 8rem); font-weight: 600; line-height: .94; letter-spacing: -.05em; }
    .service-hero-actions { gap: .75rem; }
    .service-hero-actions-desktop { display: none; margin-top: 3rem; }
    .service-hero-actions-mobile { position: absolute; right: 0; bottom: 3rem; left: 0; display: grid; }
    .service-agenda-action, .service-secondary-action { display: inline-flex; min-height: 3.25rem; align-items: center; justify-content: center; border-radius: 999px; padding: .75rem 1.5rem; font-size: .95rem; font-weight: 700; text-decoration: none; transition: transform .2s ease, background-color .2s ease; }
    .service-agenda-action { background: #804184; color: #fff; box-shadow: 0 12px 26px rgb(0 0 0 / .25); }
    .service-agenda-action:hover { background: #5f255f; transform: translateY(-2px); }
    .service-secondary-action { border: 1px solid rgb(255 255 255 / .42); background: rgb(255 255 255 / .06); color: #fff; backdrop-filter: blur(8px); }
    .service-secondary-action:hover { background: rgb(255 255 255 / .14); }
    .service-shell { width: min(100% - 2rem, 1152px); margin-inline: auto; }
    .service-content h2 { margin: 0; color: #fff; font-size: clamp(1.85rem, 3.5vw, 3rem); line-height: 1.08; letter-spacing: -.035em; }
    .service-content h3 { margin: 0; color: #fff; font-size: 1rem; }
    .service-content p { color: #d9d2b6; }
    .service-intro { padding: 5rem 0; background: linear-gradient(135deg, var(--service-deep), var(--service-middle)); }
    .service-intro-grid { display: grid; gap: 2.5rem; align-items: center; }
    .service-intro p { max-width: 34rem; margin: 1.25rem 0 0; font-size: 1.05rem; line-height: 1.65; }
    .service-intro-image { width: 100%; height: 16rem; border: 1px solid var(--service-line); border-radius: 1.75rem; object-fit: cover; box-shadow: 0 20px 45px rgb(0 0 0 / .24); }
    .service-benefits { padding: 5rem 0; background: radial-gradient(circle at 10% 0%, color-mix(in srgb, var(--service-glow) 22%, transparent), transparent 30%), linear-gradient(135deg, var(--service-middle), var(--service-deep)); }
    .service-infographic { position: relative; overflow: hidden; border: 1px solid var(--service-line); border-radius: 2rem; padding: 2rem; background: radial-gradient(circle at 92% 10%, color-mix(in srgb, var(--service-glow) 27%, transparent), transparent 28%), linear-gradient(145deg, var(--service-panel), var(--service-panel-end)); box-shadow: 0 24px 60px rgb(0 0 0 / .28), inset 0 1px 0 rgb(255 255 255 / .09); }
    .service-infographic::before { position: absolute; top: 2rem; left: 0; width: 3px; height: 5.5rem; border-radius: 0 999px 999px 0; background: linear-gradient(#b779bb, #804184); box-shadow: 0 0 18px rgb(128 65 132 / .5); content: ""; }
    .service-infographic-intro { position: relative; z-index: 1; padding-bottom: 1.75rem; border-bottom: 1px solid var(--service-line); }
    .service-infographic-intro .service-kicker { color: #d6a7d9; font-size: .75rem; }
    .service-infographic-intro p { max-width: 38rem; margin: 1rem 0 0; }
    .service-benefit-grid { position: relative; z-index: 1; display: grid; gap: 0; margin-top: 1.5rem; }
    .service-benefit-point { display: grid; grid-template-columns: 2.25rem minmax(0, 1fr); gap: .9rem; padding: 1rem 0; border-bottom: 1px solid color-mix(in srgb, var(--service-line) 62%, transparent); }
    .service-benefit-point:last-child { border-bottom: 0; }
    .service-benefit-point > span { display: grid; width: 2.25rem; height: 2.25rem; place-items: center; border: 1px solid rgb(194 123 198 / .7); border-radius: 999px; background: rgb(128 65 132 / .2); color: #e9c9eb; font-size: .7rem; font-weight: 700; }
    .service-benefit-point p { margin: .25rem 0 0; font-size: .875rem; line-height: 1.45; }
    .service-steps { padding: 5rem 0; background: linear-gradient(135deg, var(--service-deep), var(--service-middle)); }
    .service-steps-shell { max-width: 768px; }
    .service-steps-shell > h2 { text-align: center; }
    .service-step-list { display: grid; gap: 1rem; margin-top: 2rem; }
    .service-step { border: 1px solid var(--service-line); border-radius: 1.25rem; background: linear-gradient(135deg, var(--service-panel), var(--service-panel-end)); padding: 1rem 1.1rem; box-shadow: inset 0 1px 0 rgb(255 255 255 / .07); }
    .service-step[open] { border-color: #b779bb; box-shadow: 0 0 0 1px rgb(183 121 187 / .18), inset 0 1px 0 rgb(255 255 255 / .07); }
    .service-step summary { display: grid; grid-template-columns: 2rem 1fr auto; gap: .75rem; align-items: center; cursor: pointer; color: #fff; font-weight: 700; list-style: none; }
    .service-step summary::-webkit-details-marker { display: none; }
    .service-step summary > span { color: #d6a7d9; font-size: .75rem; }
    .service-step summary b { color: #e7c37b; font-size: 1.1rem; transition: transform .2s ease; }
    .service-step[open] summary b { transform: rotate(45deg); }
    .service-step p { margin: .9rem 0 0 2.75rem; line-height: 1.55; }
    .service-testimonials { padding: 5rem 0; background: radial-gradient(circle at 90% 80%, color-mix(in srgb, var(--service-glow) 16%, transparent), transparent 33%), linear-gradient(135deg, var(--service-middle), var(--service-deep)); }
    .service-testimonials > .service-shell > h2 { text-align: center; }
    .service-testimonial-grid { display: grid; gap: 1rem; margin-top: 2rem; }
    .service-testimonial-grid article { position: relative; overflow: hidden; border: 1px solid var(--service-line); border-radius: 1.25rem; padding: 1.5rem; background: linear-gradient(145deg, var(--service-panel), var(--service-panel-end)); box-shadow: inset 3px 0 0 #804184, 0 16px 38px rgb(0 0 0 / .22); }
    .service-testimonial-grid article::after { position: absolute; top: .35rem; right: 1rem; color: rgb(183 121 187 / .22); content: "“"; font-family: Georgia, serif; font-size: 4.5rem; line-height: 1; }
    .service-testimonial-grid p { position: relative; z-index: 1; margin: 0; color: #fff; }
    .service-testimonial-name { margin-top: 1rem !important; font-weight: 700; }
    .service-testimonial-role { font-size: .8rem; }
    .service-final-cta { padding: 5rem 1rem; background: radial-gradient(circle at 50% 0%, color-mix(in srgb, var(--service-glow) 24%, transparent), transparent 44%), var(--service-deep); text-align: center; }
    .service-final-copy { max-width: 40rem; margin-inline: auto; }
    .service-final-copy p { margin: 1rem 0 1.5rem; font-size: 1.05rem; }
    .service-final-copy .service-agenda-action { min-width: 12rem; }
    @media (min-width: 640px) { .service-hero-content, .service-hero-actions-mobile, .service-shell { width: min(100% - 3rem, 1152px); } .service-hero-content { padding-top: 10rem; } .service-hero-actions-mobile { bottom: 4rem; } .service-hero-actions { grid-auto-flow: column; grid-auto-columns: max-content; justify-content: start; } .service-hero-actions-mobile { display: grid; } .service-infographic { padding: 3rem; border-radius: 2.5rem; } .service-intro-image { height: 20rem; } }
    @media (min-width: 768px) { .service-benefit-grid, .service-testimonial-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: 2.5rem; } .service-benefit-point:nth-last-child(2) { border-bottom: 0; } }
    @media (min-width: 1024px) { .service-hero { min-height: 100vh; } .service-hero-content { width: min(100% - 4rem, 1440px); display: flex; min-height: 100vh; align-items: center; padding-top: 0; } .service-hero h1 { font-size: clamp(5.5rem, 7vw, 8rem); } .service-hero-actions-desktop { display: flex; } .service-hero-actions-mobile { display: none; } .service-hero-actions .service-agenda-action, .service-hero-actions .service-secondary-action { min-height: 3.75rem; padding-inline: 2.25rem; font-size: 1.1rem; } .service-shell { width: min(100% - 4rem, 1152px); } .service-intro-grid { grid-template-columns: 1fr 1fr; gap: 5rem; } .service-intro-image { height: 25rem; } .service-testimonial-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  </style>

  <script>
    import { animate, stagger } from "animejs";
    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    if (!reduceMotion) {
      animate("[data-hero-copy]", { opacity: { from: 0 }, y: { from: 32 }, duration: 850, ease: "outExpo" });
      animate("[data-hero-actions]", { opacity: { from: 0 }, y: { from: 20 }, delay: 180, duration: 700, ease: "outExpo" });
      const revealObserver = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          const target = entry.target;
          const targets = target.matches("[data-reveal-cards]") ? Array.from(target.children) : [target];
          animate(targets, { opacity: { from: 0 }, y: { from: 28 }, scale: { from: .98 }, delay: targets.length > 1 ? stagger(80) : 0, duration: 700, ease: "outExpo" });
          revealObserver.unobserve(target);
        });
      }, { threshold: .16, rootMargin: "0px 0px -8%" });
      document.querySelectorAll("[data-reveal-pair] > *, [data-reveal-header], [data-reveal-cards]").forEach((element) => revealObserver.observe(element));
    }
  </script>
</MainLayout>
