---
import "../styles/global.css";
import { Image } from 'astro:assets';
import Logo from "../images/logo.png";

interface Props {
  title: string;
  description?: string;
  currentPath?: string;
  headerVariant?: "default" | "overlay";
  headerTone?: "warm" | "forest";
}

const { title, description, currentPath, headerVariant = "default", headerTone = "warm" } = Astro.props as Props;
const isOverlayHeader = headerVariant === "overlay";

const site = Astro.site;
const path = currentPath ?? "/";
const canonicalUrl = site ? new URL(path, site).toString() : undefined;
const defaultDescription =
  "DETOXNatural en Tuxtla Gutiérrez, Chiapas: programas de nutrición, acupuntura y medicina natural para tu salud integral.";

const schemaOrg = {
  "@context": "https://schema.org",
  "@type": "HealthAndBeautyBusiness",
  name: "DETOXNatural",
  description: description || defaultDescription,
  ...(canonicalUrl && { url: canonicalUrl }),
  telephone: "+52 961 144 8411",
  address: {
    "@type": "PostalAddress",
    streetAddress: "5a. Norte Ote. No 384, Local B, Colonia Teran",
    addressLocality: "Tuxtla Gutiérrez",
    addressRegion: "Chiapas",
    addressCountry: "MX"
  }
};

const navItems = [
  { href: "/", label: "Inicio" },
  { href: "/nutricion", label: "Nutrición" },
  { href: "/acupuntura", label: "Acupuntura" },
  { href: "/medicina-natural", label: "Medicina Natural" },
  { href: "/contacto", label: "Contáctenos" }
];
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="robots" content="index,follow" />
    <meta name="author" content="DETOXNatural" />
    <meta name="theme-color" content="#4C1D95" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
    <meta property="og:site_name" content="DETOXNatural" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    {canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
    <meta property="og:locale" content="es_MX" />
    <meta property="og:image" content={Logo.src} />
    <meta property="og:image:alt" content="Logo de DETOXNatural" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    {description && <meta name="twitter:description" content={description} />}
    <meta name="twitter:image" content={Logo.src} />
    <style is:global>
      header[data-overlay-header="true"][data-surface="dark"] {
        border-color: rgb(255 255 255 / 0.22);
        background: linear-gradient(135deg, rgb(45 19 8 / 0.78), rgb(25 9 3 / 0.62), rgb(16 6 2 / 0.52));
      }

      header[data-overlay-header="true"][data-tone="forest"][data-surface="dark"] {
        background: linear-gradient(135deg, rgb(16 42 28 / 0.82), rgb(12 31 21 / 0.68), rgb(7 20 13 / 0.56));
      }

      header[data-overlay-header="true"][data-surface="dark"] .overlay-brand,
      header[data-overlay-header="true"][data-surface="dark"] .overlay-nav {
        color: #fff;
      }

      header[data-overlay-header="true"][data-surface="dark"] .overlay-nav a {
        color: rgb(255 255 255 / 0.86);
      }

      header[data-overlay-header="true"][data-surface="dark"] .overlay-nav a:hover {
        color: #fff;
      }

      header[data-overlay-header="true"][data-surface="dark"] .overlay-subtitle {
        color: rgb(255 255 255 / 0.78);
      }

      header[data-overlay-header="true"][data-surface="dark"] .overlay-cta {
        background-color: #804184;
        color: #fff;
      }

      header[data-overlay-header="true"][data-surface="dark"] .overlay-menu-trigger {
        border-color: rgb(255 255 255 / 0.35);
        background-color: rgb(255 255 255 / 0.12);
        color: #fff;
      }
    </style>
    <script type="application/ld+json">
      {JSON.stringify(schemaOrg)}
    </script>
  </head>
  <body class="min-h-screen bg-slate-50 text-slate-900 antialiased">
    <div class="flex min-h-screen flex-col">
      <header
        data-overlay-header={isOverlayHeader ? "true" : undefined}
        data-surface={isOverlayHeader ? "dark" : undefined}
        data-tone={isOverlayHeader ? headerTone : undefined}
        class:list={[
          "z-30",
          isOverlayHeader
            ? "fixed left-1/2 top-3 w-[calc(100%-1.5rem)] max-w-[1280px] -translate-x-1/2 rounded-[2rem] border border-white/25 bg-gradient-to-br from-[#193729]/85 via-[#10281d]/78 to-[#0b1e16]/72 shadow-[0_14px_40px_rgba(5,15,10,0.35),inset_0_1px_0_rgba(255,255,255,0.18)] backdrop-blur-xl backdrop-saturate-150 transition-colors duration-300 sm:top-4 sm:w-[calc(100%-3rem)]"
            : "sticky top-3 mx-auto w-[calc(100%-1.5rem)] max-w-[1280px] rounded-[2rem] border border-white/25 bg-gradient-to-br from-[#193729]/90 via-[#10281d]/85 to-[#0b1e16]/80 shadow-[0_14px_40px_rgba(5,15,10,0.3),inset_0_1px_0_rgba(255,255,255,0.18)] backdrop-blur-xl backdrop-saturate-150 sm:top-4 sm:w-[calc(100%-3rem)]"
        ]}
      >
        <div
          class:list={[
            "mx-auto flex items-center justify-between gap-4 px-4 py-3 sm:px-6 xl:grid xl:grid-cols-[1fr_auto_1fr] xl:gap-6 xl:px-8",
            "max-w-[1280px]"
          ]}
        >
          <a href="/" class="flex items-center gap-3 xl:justify-self-start">
            <div>
              <Image src={Logo} alt="Logo" class="flex h-12 w-12 items-center justify-center rounded-2xl shadow-md" />
            </div>
            <div class="leading-tight">
              <p class="overlay-brand text-sm font-semibold tracking-wide text-white">
                DETOXNatural
              </p>
              <p class="overlay-subtitle text-xs text-white/75">
                Sanación integral y bienestar
              </p>
            </div>
          </a>

          <nav class="overlay-nav hidden items-center gap-4 text-sm font-medium text-white/85 xl:flex xl:justify-self-center">
            {navItems.map((item) => {
              const active = currentPath === item.href;
              return (
                <a
                  href={item.href}
                  class:list={[
                    "transition-colors",
                    "hover:text-white",
                    active ? "text-white" : ""
                  ]}
                >
                  {item.label}
                </a>
              );
            })}
          </nav>

          <div class="hidden xl:block xl:justify-self-end">
            <a
              href="tel:+529611448411"
              class:list={[
                "overlay-cta rounded-full px-4 py-2 text-sm font-semibold shadow-md transition",
                isOverlayHeader
                  ? "bg-[#804184] text-white shadow-[#120805]/30 hover:bg-[#5f255f]"
                  : "bg-purple-700 text-white shadow-purple-300/60 hover:bg-purple-800"
              ]}
            >
              Agenda tu Consulta
            </a>
          </div>

          <div class="xl:hidden">
            <details class="relative">
              <summary
                class:list={[
                  "overlay-menu-trigger flex cursor-pointer items-center gap-2 rounded-full border border-white/30 bg-white/10 px-3 py-1.5 text-xs font-medium text-white shadow-sm backdrop-blur"
                ]}
              >
                <span>Menú</span>
                <span aria-hidden="true">▾</span>
              </summary>
              <div
                class="absolute right-0 z-20 mt-2 w-48 rounded-xl border border-slate-100 bg-white p-3 text-sm shadow-lg"
              >
                <nav class="flex flex-col gap-2">
                  {navItems.map((item) => {
                    const active = currentPath === item.href;
                    return (
                      <a
                        href={item.href}
                        class:list={[
                          "rounded-lg px-3 py-1.5 transition-colors hover:bg-purple-50 hover:text-purple-700",
                          active ? "bg-purple-50 text-purple-700" : "text-slate-700"
                        ]}
                      >
                        {item.label}
                      </a>
                    );
                  })}
                  <a
                    href="tel:+529611448411"
                    class="mt-1 rounded-full bg-purple-700 px-3 py-1.5 text-center text-xs font-semibold text-white shadow-sm hover:bg-purple-800"
                  >
                    Agenda tu Consulta
                  </a>
                </nav>
              </div>
            </details>
          </div>
        </div>
      </header>

      {isOverlayHeader && (
        <script is:inline>
          {`
            const overlayHeader = document.querySelector('[data-overlay-header="true"]');
            const overlayHero = document.querySelector('[data-hero-surface]');
            const updateOverlayHeader = () => {
              if (!overlayHeader) return;
              overlayHeader.dataset.scrolled = String(window.scrollY > 20);
              const heroBottom = overlayHero?.getBoundingClientRect().bottom ?? 0;
              overlayHeader.dataset.surface = heroBottom > overlayHeader.offsetHeight + 24 ? 'dark' : 'light';
            };
            updateOverlayHeader();
            window.addEventListener('scroll', updateOverlayHeader, { passive: true });
            window.addEventListener('resize', updateOverlayHeader);
          `}
        </script>
      )}

      <main class="flex-1">
        <slot />
      </main>

      <a
        href="https://wa.me/529611448411?text=Hola%2C%20me%20gustar%C3%ADa%20agendar%20una%20consulta."
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Enviar un mensaje por WhatsApp para agendar una consulta"
        class="fixed bottom-5 right-5 z-40 inline-flex h-14 w-14 items-center justify-center rounded-full bg-[#25D366] text-white shadow-lg shadow-black/25 transition duration-200 hover:scale-110 hover:bg-[#1ebe5d] focus:outline-none focus:ring-4 focus:ring-[#25D366]/35"
      >
        <svg viewBox="0 0 24 24" class="h-7 w-7" fill="currentColor" aria-hidden="true">
          <path d="M19.05 4.94A9.87 9.87 0 0 0 12.04 2C6.58 2 2.14 6.44 2.14 11.9c0 1.75.46 3.46 1.33 4.96L2 22l5.3-1.39a9.86 9.86 0 0 0 4.73 1.2h.01c5.45 0 9.89-4.44 9.89-9.9a9.82 9.82 0 0 0-2.88-6.97ZM12.04 20.14a8.2 8.2 0 0 1-4.18-1.14l-.3-.18-3.15.83.84-3.07-.2-.31a8.2 8.2 0 1 1 7 3.87h-.01Zm4.5-6.15c-.25-.13-1.48-.73-1.71-.81-.23-.08-.4-.13-.57.13-.17.25-.65.81-.8.98-.15.17-.3.19-.55.06-.25-.13-1.06-.39-2.02-1.25-.75-.67-1.25-1.49-1.4-1.74-.15-.25-.02-.38.11-.51.12-.12.25-.3.38-.45.13-.15.17-.25.25-.42.08-.17.04-.32-.02-.45-.06-.13-.57-1.38-.78-1.89-.2-.49-.41-.42-.57-.43h-.48c-.17 0-.45.06-.68.32-.23.25-.9.88-.9 2.15s.92 2.49 1.05 2.66c.13.17 1.81 2.76 4.38 3.87.61.26 1.08.42 1.45.54.61.19 1.17.16 1.61.1.49-.07 1.48-.61 1.69-1.2.21-.59.21-1.09.15-1.2-.06-.11-.22-.17-.47-.3Z" />
        </svg>
        <span class="sr-only">WhatsApp</span>
      </a>

      <footer class="mt-12 border-t border-slate-200 bg-white">
        <div
          class="mx-auto flex max-w-6xl flex-col gap-10 px-4 py-10 text-sm text-slate-600 sm:px-6 lg:px-8 lg:flex-row lg:items-start lg:justify-between"
        >
          <div class="flex items-center gap-3">
            <div>
            <Image src={Logo} alt="Logo" class="flex h-12 w-12 items-center justify-center rounded-2xl shadow-md" />
            </div>
            <div>
              <p class="text-sm font-semibold text-slate-900">DETOXNatural</p>
              <p class="mt-1 max-w-xs text-xs text-slate-500">
                Holistic healing for a transformative life.
              </p>
            </div>
          </div>

          <div class="grid flex-1 gap-8 sm:grid-cols-3">
            <div>
              <h3 class="text-xs font-semibold uppercase tracking-wide text-slate-400">
                Services
              </h3>
              <ul class="mt-3 space-y-2">
                <li>Nutrición</li>
                <li>Acupuntura</li>
                <li>Medicina Natural</li>
              </ul>
            </div>

            <div>
              <h3 class="text-xs font-semibold uppercase tracking-wide text-slate-400">
                Quick Links
              </h3>
              <ul class="mt-3 space-y-2">
                <li>
                  <a href="/" class="hover:text-purple-700">Inicio</a>
                </li>
                <li>
                  <a href="/contacto" class="hover:text-purple-700">Contáctenos</a>
                </li>
              </ul>
            </div>

            <div>
              <h3 class="text-xs font-semibold uppercase tracking-wide text-slate-400">
                Contact
              </h3>
              <ul class="mt-3 space-y-2">
                <li>5a. Norte Ote. No 384, Local B, Colonia Teran</li>
                <li>Tuxtla Gutiérrez, Chiapas</li>
                <li>Teléfono: 961 144 8411</li>
                <li>Correo: detoxnatural@hotmail.com</li>
              </ul>
            </div>
          </div>
        </div>

        <div class="border-t border-slate-100 bg-slate-50">
          <p class="mx-auto max-w-6xl px-4 py-4 text-center text-xs text-slate-500 sm:px-6 lg:px-8">
            © 2025 DETOXNatural. All rights reserved.
          </p>
        </div>
      </footer>
    </div>
  </body>
</html>
