---
import "../styles/global.css";
import { Image } from 'astro:assets';
import Logo from "../images/logo.png";

interface Props {
  title: string;
  description?: string;
  currentPath?: string;
}

const { title, description, currentPath } = Astro.props as Props;

const site = Astro.site;
const path = currentPath ?? "/";
const canonicalUrl = site ? new URL(path, site).toString() : undefined;
const defaultDescription =
  "DETOXNatural en Tuxtla Gutiérrez, Chiapas: programas de nutrición, acupuntura y medicina natural para tu salud integral.";

const schemaOrg = {
  "@context": "https://schema.org",
  "@type": "HealthAndBeautyBusiness",
  name: "DETOXNatural",
  description: description || defaultDescription,
  ...(canonicalUrl && { url: canonicalUrl }),
  telephone: "+52 961 144 8411",
  address: {
    "@type": "PostalAddress",
    streetAddress: "5a. Norte Ote. No 384, Local B, Colonia Teran",
    addressLocality: "Tuxtla Gutiérrez",
    addressRegion: "Chiapas",
    addressCountry: "MX"
  }
};

const navItems = [
  { href: "/", label: "Inicio" },
  { href: "/nutricion", label: "Nutrición" },
  { href: "/acupuntura", label: "Acupuntura" },
  { href: "/medicina-natural", label: "Medicina Natural" },
  { href: "/contacto", label: "Contáctenos" }
];
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="robots" content="index,follow" />
    <meta name="author" content="DETOXNatural" />
    <meta name="theme-color" content="#4C1D95" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
    <meta property="og:site_name" content="DETOXNatural" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    {canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
    <meta property="og:locale" content="es_MX" />
    <meta property="og:image" content={Logo.src} />
    <meta property="og:image:alt" content="Logo de DETOXNatural" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    {description && <meta name="twitter:description" content={description} />}
    <meta name="twitter:image" content={Logo.src} />
    <script type="application/ld+json">
      {JSON.stringify(schemaOrg)}
    </script>
  </head>
  <body class="min-h-screen bg-slate-50 text-slate-900 antialiased">
    <div class="flex min-h-screen flex-col">
      <header class="sticky top-0 z-30 border-b border-purple-100 bg-white/90 shadow-sm backdrop-blur">
        <div
          class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-3 sm:px-6 lg:px-8"
        >
          <a href="/" class="flex items-center gap-3">
            <div>
              <Image src={Logo} alt="Logo" class="flex h-12 w-12 items-center justify-center rounded-2xl shadow-md" />
            </div>
            <div class="leading-tight">
              <p class="text-sm font-semibold tracking-wide text-slate-900">
                DETOXNatural
              </p>
              <p class="text-xs text-slate-500">
                Sanación integral y bienestar
              </p>
            </div>
          </a>

          <nav class="hidden items-center gap-6 text-sm font-medium text-slate-600 md:flex">
            {navItems.map((item) => {
              const active = currentPath === item.href;
              return (
                <a
                  href={item.href}
                  class:list={[
                    "transition-colors hover:text-purple-700",
                    active ? "text-purple-700" : ""
                  ]}
                >
                  {item.label}
                </a>
              );
            })}
          </nav>

          <div class="hidden md:block">
            <a
              href="tel:+529611448411"
              class="rounded-full bg-purple-700 px-4 py-2 text-sm font-semibold text-white shadow-md shadow-purple-300/60 transition hover:bg-purple-800"
            >
              Agenda tu Consulta
            </a>
          </div>

          <div class="md:hidden">
            <details class="relative">
              <summary
                class="flex cursor-pointer items-center gap-2 rounded-full border border-slate-200 bg-white px-3 py-1.5 text-xs font-medium text-slate-700 shadow-sm"
              >
                <span>Menú</span>
                <span aria-hidden="true">▾</span>
              </summary>
              <div
                class="absolute right-0 z-20 mt-2 w-48 rounded-xl border border-slate-100 bg-white p-3 text-sm shadow-lg"
              >
                <nav class="flex flex-col gap-2">
                  {navItems.map((item) => {
                    const active = currentPath === item.href;
                    return (
                      <a
                        href={item.href}
                        class:list={[
                          "rounded-lg px-3 py-1.5 transition-colors hover:bg-purple-50 hover:text-purple-700",
                          active ? "bg-purple-50 text-purple-700" : "text-slate-700"
                        ]}
                      >
                        {item.label}
                      </a>
                    );
                  })}
                  <a
                    href="tel:+529611448411"
                    class="mt-1 rounded-full bg-purple-700 px-3 py-1.5 text-center text-xs font-semibold text-white shadow-sm hover:bg-purple-800"
                  >
                    Agenda tu Consulta
                  </a>
                </nav>
              </div>
            </details>
          </div>
        </div>
      </header>

      <main class="flex-1">
        <slot />
      </main>

      <footer class="mt-12 border-t border-slate-200 bg-white">
        <div
          class="mx-auto flex max-w-6xl flex-col gap-10 px-4 py-10 text-sm text-slate-600 sm:px-6 lg:px-8 lg:flex-row lg:items-start lg:justify-between"
        >
          <div class="flex items-center gap-3">
            <div>
            <Image src={Logo} alt="Logo" class="flex h-12 w-12 items-center justify-center rounded-2xl shadow-md" />
            </div>
            <div>
              <p class="text-sm font-semibold text-slate-900">DETOXNatural</p>
              <p class="mt-1 max-w-xs text-xs text-slate-500">
                Holistic healing for a transformative life.
              </p>
            </div>
          </div>

          <div class="grid flex-1 gap-8 sm:grid-cols-3">
            <div>
              <h3 class="text-xs font-semibold uppercase tracking-wide text-slate-400">
                Services
              </h3>
              <ul class="mt-3 space-y-2">
                <li>Nutrición</li>
                <li>Acupuntura</li>
                <li>Medicina Natural</li>
              </ul>
            </div>

            <div>
              <h3 class="text-xs font-semibold uppercase tracking-wide text-slate-400">
                Quick Links
              </h3>
              <ul class="mt-3 space-y-2">
                <li>
                  <a href="/" class="hover:text-purple-700">Inicio</a>
                </li>
                <li>
                  <a href="/contacto" class="hover:text-purple-700">Contáctenos</a>
                </li>
              </ul>
            </div>

            <div>
              <h3 class="text-xs font-semibold uppercase tracking-wide text-slate-400">
                Contact
              </h3>
              <ul class="mt-3 space-y-2">
                <li>5a. Norte Ote. No 384, Local B, Colonia Teran</li>
                <li>Tuxtla Gutiérrez, Chiapas</li>
                <li>Teléfono: 961 144 8411</li>
                <li>Correo: detoxnatural@hotmail.com</li>
              </ul>
            </div>
          </div>
        </div>

        <div class="border-t border-slate-100 bg-slate-50">
          <p class="mx-auto max-w-6xl px-4 py-4 text-center text-xs text-slate-500 sm:px-6 lg:px-8">
            © 2025 DETOXNatural. All rights reserved.
          </p>
        </div>
      </footer>
    </div>
  </body>
</html>
